#!/usr/bin/env python3
"""Print the latest supported releases as JSON (python3 standard library only).

Why these sources: endoflife.date is a public API kept current for languages, so
the kit never copies a version from an old template; RubyGems has Rails; npm has
Lighthouse when requested; Docker
Hub says whether an official ruby image tag exists yet (new patch releases can lag).
Everything is Debian: the kit strongly prefers it (see README, "Why the choices").
"""
import argparse, datetime, json, sys, urllib.request

def get(url):
    request = urllib.request.Request(url, headers={"User-Agent": "devcontainer-kit"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)

def supported(cycle, today):
    eol = cycle.get("eol")
    return eol is False or (isinstance(eol, str) and eol >= today)

def newest_supported(product, today):
    return next(c for c in get(f"https://endoflife.date/api/{product}.json") if supported(c, today))

def node_versions(today):
    cycles = [c for c in get("https://endoflife.date/api/nodejs.json") if supported(c, today)]
    lts = next(c for c in cycles if isinstance(c.get("lts"), str) and c["lts"] <= today)
    return lts["cycle"], cycles[0]["cycle"]

def debian_codename(today):
    """Codename of the newest released, still supported Debian (what stable-slim is)."""
    released = [c for c in get("https://endoflife.date/api/debian.json")
                if c["releaseDate"] <= today and supported(c, today)]
    return released[0]["codename"].lower()

def ruby_tag_exists(tag):
    try:
        get(f"https://hub.docker.com/v2/repositories/library/ruby/tags/{tag}")
        return True
    except Exception:
        return False

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lighthouse", action="store_true", help="also look up Lighthouse on npm")
    args = parser.parse_args()
    today = datetime.date.today().isoformat()
    ruby = newest_supported("ruby", today)
    go = newest_supported("go", today)
    node_lts, node_latest = node_versions(today)
    debian = debian_codename(today)
    exact = f"{ruby['latest']}-slim-{debian}"
    floating = f"{ruby['cycle']}-slim-{debian}"
    image = exact if ruby_tag_exists(exact) else floating
    versions = {
        "checked_on": today,
        "debian": debian,
        "ruby": ruby["latest"],
        "ruby_image": f"ruby:{image}",
        "go": go["latest"],
        "node_lts": node_lts,
        "node_latest": node_latest,
        "rails": get("https://rubygems.org/api/v1/versions/rails/latest.json")["version"],
    }
    if args.lighthouse:
        versions["lighthouse"] = get("https://registry.npmjs.org/lighthouse/latest")["version"]
    print(json.dumps(versions, indent=2))

if __name__ == "__main__":
    main()
