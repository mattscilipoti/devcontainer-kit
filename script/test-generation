#!/usr/bin/env python3
"""Generate every stack combination in a scratch directory and validate its files."""
import importlib.util
import itertools
import json
import pathlib
import re
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader

sys.dont_write_bytecode = True
KIT = pathlib.Path(__file__).resolve().parent.parent
GENERATOR_PATH = KIT / "script" / "new-devcontainer"
SPEC = importlib.util.spec_from_loader(
    "new_devcontainer", SourceFileLoader("new_devcontainer", str(GENERATOR_PATH))
)
GENERATOR = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(GENERATOR)


def generate_case(scratch, index, names, versions, browser_tests=False, lighthouse=False):
    case_dir = scratch / str(index)
    arguments = [
        "--project-dir",
        str(case_dir),
        "--stacks",
        ",".join(names),
        "--name",
        f"generation-test-{index}",
    ]
    if browser_tests:
        arguments.append("--browser-tests")
    if lighthouse:
        arguments.append("--lighthouse")
    args = GENERATOR.build_parser().parse_args(arguments)
    stacks, loaded_names = GENERATOR.load_stacks(names)
    merged, values = GENERATOR.compose(stacks, args, versions)
    files = GENERATOR.planned_files(args, merged, values, loaded_names)

    config = json.loads(files[".devcontainer/devcontainer.json"])
    pinned = json.loads(files[".devcontainer/versions.json"])
    checks = files[".devcontainer/check-dependencies.sh"]
    if lighthouse:
        if (
            pinned.get("lighthouse") != versions["lighthouse"]
            or versions["lighthouse"] not in config["onCreateCommand"]["install lighthouse"]
            or config["containerEnv"].get("CHROME_PATH") != "/usr/bin/chromium"
            or "lighthouse --version" not in checks
            or checks.count("show_version 'chromium'") != 1
            or "        chromium \\" not in files[".devcontainer/Dockerfile"]
            or ".github/workflows/lighthouse-sandbox-review.yml" not in files
        ):
            raise AssertionError("Lighthouse generation is missing its install, browser, or checks")
    elif (
        "lighthouse" in pinned
        or "lighthouse --version" in checks
        or "CHROME_PATH" in config["containerEnv"]
        or ".github/workflows/lighthouse-sandbox-review.yml" in files
    ):
        raise AssertionError("Lighthouse must be opt-in")

    workflow = files[".github/workflows/scheduled-checks.yml"]
    action_refs = re.findall(r"^\s*(?:-\s*)?uses:\s*([^\s#]+)", workflow, re.MULTILINE)
    if not action_refs or any(
        not re.fullmatch(r"[^@\s]+@[0-9a-f]{40}", ref) for ref in action_refs
    ):
        raise AssertionError("Scheduled workflow actions must use full commit SHAs")

    if "rails" in loaded_names:
        if (
            "ghcr.io/devcontainers/features/docker-in-docker:2" in config["features"]
            or "libpq-dev" in files[".devcontainer/Dockerfile"]
        ):
            raise AssertionError("Rails default generation unexpectedly enabled Postgres")

    for relative, content in files.items():
        target = case_dir / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content)

    for path in case_dir.rglob("*.json"):
        json.loads(path.read_text())
    for path in case_dir.rglob("*.sh"):
        subprocess.run(["bash", "-n", str(path)], check=True)


def main():
    versions = GENERATOR.lookup_versions(lighthouse=True)
    stack_names = sorted(path.stem for path in (KIT / "stacks").glob("*.json"))
    combinations = [
        combo
        for size in range(1, len(stack_names) + 1)
        for combo in itertools.combinations(stack_names, size)
    ]

    with tempfile.TemporaryDirectory(prefix="devcontainer-kit-") as temp:
        scratch = pathlib.Path(temp)
        for index, combo in enumerate(combinations):
            generate_case(scratch, index, combo, versions)

        generate_case(scratch, len(combinations), ("web",), versions, lighthouse=True)
        generate_case(
            scratch,
            len(combinations) + 1,
            ("rails", "web"),
            versions,
            browser_tests=True,
            lighthouse=True,
        )
        result = subprocess.run(
            [sys.executable, str(GENERATOR_PATH), "--project-dir", str(scratch / "invalid"),
             "--stacks", "go", "--lighthouse"],
            text=True,
            capture_output=True,
        )
        if result.returncode == 0 or "--lighthouse requires the web stack" not in result.stderr:
            raise AssertionError("Lighthouse without web must fail clearly")

    print(
        f"Validated {len(combinations)} stack combinations and "
        "Lighthouse with web and Rails browser-tests."
    )


if __name__ == "__main__":
    main()
